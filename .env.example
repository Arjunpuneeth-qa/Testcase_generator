# JIRA Test Case Generator - Environment Variables
#
# Copy this file to .env and fill in your JIRA credentials
# DO NOT commit this file to version control (keep it private)
#
# How to get your JIRA API token:
# 1. Visit: https://id.atlassian.com/manage-profile/security/api-tokens
# 2. Click "Create API token"
# 3. Give it a name: "Test Case Generator"
# 4. Copy the token and paste it below
# 5. Keep this file private!

# Your JIRA email address
JIRA_EMAIL=am.puneeth@bounteous.com

# Your JIRA API token (get from https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your_api_token_here_replace_me
